# ─────────────────────────────────────────────────────────────────────────────
# Afrux Marketing (PVT) Ltd – White-Label .env
#
# Copy this file to the electron-desktop project root and rename to .env
# to produce an Afrux-branded build. ALL values below carefully override the
# Inzeedo defaults defined in src/lib/branding.js
# ─────────────────────────────────────────────────────────────────────────────

# ─── API & Core Configuration ──────────────────────────────────────────────────
# NEXT_PUBLIC_API_BASE_URL: The base URL of the backend API endpoints.
# This should map exactly to your backend's API v1 prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# NEXT_PUBLIC_IMAGE_BASE_URL: The root domain where images are hosted.
# Used for fetching product images or profile avatars uploaded to the backend.
# NOTE: Do NOT include /api/v1 here. It must point to the root backend domain.
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:5000

# NEXTAUTH_SECRET: A strong 32+ character random string used for signing session cookies.
NEXTAUTH_SECRET=Xk3f9L2yZp8sQvYcR+u6mKcH0B9R7Jw2D5nE4A==
# NEXTAUTH_URL: The base URL of this frontend application.
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SESSION_MAX_AGE / _UPDATE_AGE: Session expiration timers in seconds.
NEXTAUTH_SESSION_MAX_AGE=2592000
NEXTAUTH_SESSION_UPDATE_AGE=86400


# ─── White-Label Branding ─────────────────────────────────────────────────────
#
# NEXT_PUBLIC_APP_NAME: The full legal name of the application.
# Used on receipt footers ("Generated by {APP_NAME} System") and the splash screen.
NEXT_PUBLIC_APP_NAME="Afrux Marketing (PVT) Ltd"

# NEXT_PUBLIC_APP_SHORT_NAME: The abbreviated brand name.
# Used in copyrights, POS terminals, and short receipt footers ("ERP SYSTEM FROM {SHORT_NAME}").
NEXT_PUBLIC_APP_SHORT_NAME="Afrux POS"

# NEXT_PUBLIC_PAGE_TITLE_SUFFIX: Used at the end of browser tab titles.
# Example: "Settings | {PAGE_TITLE_SUFFIX}"
NEXT_PUBLIC_PAGE_TITLE_SUFFIX="Afrux POS"

# NEXT_PUBLIC_APP_LOGO & LOGO_LIGHT: Paths (or external URLs) to the company logos.
# Used in the sidebar navigation, splash screen, and auth forms.
NEXT_PUBLIC_APP_LOGO="/logos/afrux-logo.png"
NEXT_PUBLIC_APP_LOGO_LIGHT="/logos/afrux-logo-light.png"

# NEXT_PUBLIC_APP_FAVICON: The icon image used on browser tabs.
NEXT_PUBLIC_APP_FAVICON="/favicons/afrux.ico"

# NEXT_PUBLIC_PRIMARY_COLOR: The hex color used across the application for buttons, active links, and accents.
NEXT_PUBLIC_PRIMARY_COLOR="#0f766e"


# ─── Contact Information ──────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPPORT_EMAIL & PHONE: Contact details shown in support pages, footers, and receipts.
NEXT_PUBLIC_SUPPORT_EMAIL="support@afrux.lk"
NEXT_PUBLIC_SUPPORT_PHONE="+94701409027"

# NEXT_PUBLIC_COMPANY_WEBSITE: The public landing page of the company.
NEXT_PUBLIC_COMPANY_WEBSITE="https://afrux.lk"


# ─── Feature Flags ────────────────────────────────────────────────────────────
# NEXT_PUBLIC_IS_WHITE_LABEL: If true, removes "Developed by Inzeedo" footers and hides system configs.
NEXT_PUBLIC_IS_WHITE_LABEL=true

# NEXT_PUBLIC_SHOW_SUBSCRIPTION / HEALTH: Hide these superadmin modules from client builds.
NEXT_PUBLIC_SHOW_SUBSCRIPTION=false
NEXT_PUBLIC_SHOW_SYSTEM_HEALTH=false
